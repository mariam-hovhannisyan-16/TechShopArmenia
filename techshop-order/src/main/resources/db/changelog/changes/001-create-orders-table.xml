<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-orders-table" author="techshop">
        <createTable tableName="orders">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="shipping_full_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="shipping_phone" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="shipping_line1" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="shipping_line2" type="VARCHAR(200)"/>
            <column name="shipping_city" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="shipping_state" type="VARCHAR(100)"/>
            <column name="shipping_postal_code" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="shipping_country" type="VARCHAR(100)"><constraints nullable="false"/></column>

            <column name="billing_full_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="billing_phone" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="billing_line1" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="billing_line2" type="VARCHAR(200)"/>
            <column name="billing_city" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="billing_state" type="VARCHAR(100)"/>
            <column name="billing_postal_code" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="billing_country" type="VARCHAR(100)"><constraints nullable="false"/></column>

            <column name="notes" type="VARCHAR(500)"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="orders" indexName="idx_orders_user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="orders" indexName="idx_orders_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
