<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Verified-purchase product reviews. product_id/user_id are plain BIGINTs with no FK -
         same convention as order_items.product_id and orders.user_id already use in this
         service - since the referenced rows live in techshop-product's and techshop-user's own
         databases, not this one. The unique constraint enforces one review per user per product
         at the DB level (ReviewServiceImpl also checks this up front for a clean 409 instead of
         a constraint-violation 500, the same belt-and-suspenders approach as
         UsersEmailUniqueConstraintMigrationTest's uk_users_email). -->
    <changeSet id="010-create-reviews-table" author="techshop">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="reviews"/>
            </not>
        </preConditions>
        <createTable tableName="reviews">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="reviews" columnNames="product_id, user_id"
                              constraintName="uk_reviews_product_user"/>

        <createIndex tableName="reviews" indexName="idx_reviews_product_id">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
