<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="008-drop-digital-twin-repair-entry-table" author="mariam">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="digital_twin_repair_entry"/>
        </preConditions>
        <dropTable tableName="digital_twin_repair_entry" cascadeConstraints="true"/>
    </changeSet>

    <changeSet id="008-drop-product-digital-twin-table" author="mariam">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="product_digital_twin"/>
        </preConditions>
        <dropTable tableName="product_digital_twin" cascadeConstraints="true"/>
    </changeSet>

</databaseChangeLog>
