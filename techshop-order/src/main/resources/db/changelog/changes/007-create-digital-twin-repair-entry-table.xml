<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-create-digital-twin-repair-entry-table" author="mariam">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="digital_twin_repair_entry"/>
            </not>
        </preConditions>
        <createTable tableName="digital_twin_repair_entry">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="digital_twin_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="entry_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="digital_twin_repair_entry" baseColumnNames="digital_twin_id"
                                  constraintName="fk_repair_entry_digital_twin"
                                  referencedTableName="product_digital_twin" referencedColumnNames="id"
                                  onDelete="CASCADE"/>

        <createIndex tableName="digital_twin_repair_entry" indexName="idx_repair_entry_digital_twin_id">
            <column name="digital_twin_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
