# Reference for the environment variables consumed by the services in docker-compose.yml
# and each module's application.yml (${VAR:default} placeholders). Not wired into
# docker-compose directly -- copy the values you need into your shell or a local
# override before running `docker compose up`.

# --- Database (shared Postgres instance, one DB per service, see init.sql) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Auth (techshop-user issues tokens; techshop-order/wishlist validate them) ---
JWT_SECRET=local-dev-secret-change-in-production

# --- Internal service-to-service calls (e.g. order -> product stock adjustment) ---
INTERNAL_API_KEY=local-dev-internal-key-change-in-production

# --- Payment sandbox keys (techshop-order payment module) ---
# Placeholders only -- no real merchant credentials exist yet. Both providers run in
# sandbox mode (mock createPayment/verifyPayment) until real keys are supplied and
# sandbox-mode is set to false.
IDRAM_SANDBOX_MODE=true
IDRAM_SANDBOX_URL=https://sandbox.idram.am/payment
IDRAM_MERCHANT_ID=sandbox-merchant
IDRAM_SECRET_KEY=sandbox-secret

TELCELL_SANDBOX_MODE=true
TELCELL_SANDBOX_URL=https://sandbox.telcellwallet.am/payment
TELCELL_MERCHANT_ID=sandbox-merchant
TELCELL_SECRET_KEY=sandbox-secret
