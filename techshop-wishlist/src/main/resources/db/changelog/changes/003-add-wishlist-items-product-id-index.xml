<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-add-wishlist-items-product-id-index" author="techshop">
        <!-- uk_wishlist_item_product covers (wishlist_id, product_id) but with product_id as the
             second column, so it doesn't serve findUserIdsByProductId's product_id-only lookup
             (used on every price-drop notification fan-out) without a full scan. -->
        <createIndex tableName="wishlist_items" indexName="idx_wishlist_items_product_id">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
