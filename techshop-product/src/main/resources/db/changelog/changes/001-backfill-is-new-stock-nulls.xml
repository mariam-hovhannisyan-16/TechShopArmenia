<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-backfill-null-is-new" author="techshop">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="products" columnName="is_new"/>
        </preConditions>
        <update tableName="products">
            <column name="is_new" valueBoolean="false"/>
            <where>is_new IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="001-backfill-null-stock" author="techshop">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="products" columnName="stock"/>
        </preConditions>
        <update tableName="products">
            <column name="stock" valueNumeric="0"/>
            <where>stock IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
