    <!-- The users table used to be created by Hibernate's ddl-auto (previously
         `update`, now `validate`). Liquibase now owns creation too, via a
         guarded changeset that no-ops if the table already exists (on an
         existing deployment where Hibernate created it previously), so this
         changelog works unmodified on both a fresh database and an existing
         one. -->
    <include file="db/changelog/changes/000-create-users-table.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/changes/001-dedupe-users-by-email.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/changes/002-add-unique-constraint-on-users-email.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/changes/003-add-notify-price-drops-to-users.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>
